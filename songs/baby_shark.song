# Baby Shark (Pinkfong) -- main "doo doo doo" hook, simplified.
# Source transcription (letter notes): https://noobnotes.net/baby-shark-pinkfong/
#   Original letter notes:   D - E   G G G G G G G   (Baby shark, doo doo doo doo doo doo)
#   Ending:                  G - G   F#
# Simplified to a single monophonic line in the key of G, repeated for each
# shark (baby / mummy / daddy / grandpa), then the "Baby shark!" ending.
name: Baby Shark
tempo: 4
slots_per_beat: 2
melody:
    # Baby shark, doo doo doo doo doo doo   (x4 sharks)
    D4/0.5 E4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5
    D4/0.5 E4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5
    D4/0.5 E4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5
    D4/0.5 E4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5 G4/0.5
    # Baby shark!
    G4/0.5 G4/0.5 F#4/1
