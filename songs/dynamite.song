# Dynamite (BTS) -- VERSE 1 only, simplified.
# Source transcription (letter notes): https://www.mintmusic.co.uk/2020/09/dynamite-bts.html
#   (uppercase letters in the source = sharps)
#     Db E E E E Db E            "Shoes on, get up in the morn'"
#     E Db E E E Db E            "Cup of milk, let's rock and roll"
#     E E E Db E                 "King Kong, kick the drum"
#     E Db E E Db E Db E         "Rolling on like a Rolling Stone"
#     E E E Db E Db E            "Sing song when I'm walking home"
#     E Db E Db Ab F# Db Db B    "Jump up to the top, LeBron"
#     E E E Db E Db E            "Ding-dong, call me on my phone"
#     E Db E E Db E Db E Db      "Ice tea and a game of ping pong"
# Transposed to keep every note inside the toy's G#3..D#6 range; the low B of
# "LeBron" is kept at B4.
name: Dynamite
tempo: 4
slots_per_beat: 2
melody:
    # Shoes on, get up in the morn'
    C#5/0.5 E5/0.5 E5/0.5 E5/0.5 E5/0.5 C#5/0.5 E5/1
    # Cup of milk, let's rock and roll
    E5/0.5 C#5/0.5 E5/0.5 E5/0.5 E5/0.5 C#5/0.5 E5/1
    # King Kong, kick the drum
    E5/0.5 E5/0.5 E5/0.5 C#5/0.5 E5/1
    # Rolling on like a Rolling Stone
    E5/0.5 C#5/0.5 E5/0.5 E5/0.5 C#5/0.5 E5/0.5 C#5/0.5 E5/1
    # Sing song when I'm walking home
    E5/0.5 E5/0.5 E5/0.5 C#5/0.5 E5/0.5 C#5/0.5 E5/1
    # Jump up to the top, LeBron
    E5/0.5 C#5/0.5 E5/0.5 C#5/0.5 G#5/0.5 F#5/0.5 C#5/0.5 C#5/0.5 B4/1
    # Ding-dong, call me on my phone
    E5/0.5 E5/0.5 E5/0.5 C#5/0.5 E5/0.5 C#5/0.5 E5/1
    # Ice tea and a game of ping pong
    E5/0.5 C#5/0.5 E5/0.5 E5/0.5 C#5/0.5 E5/0.5 C#5/0.5 E5/0.5 C#5/1
