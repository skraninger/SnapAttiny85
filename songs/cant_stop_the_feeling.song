# Can't Stop the Feeling! (Justin Timberlake) -- CHORUS only, simplified.
# Source transcription (letter notes): https://www.pianokeyboardnotes.com/cant-stop-the-feeling-piano.html
#   The site notates the chorus melody mostly on C and D:
#     [C] (D*) C* D*  (D*) C* D*  (D*) C* D*     "Nothing I can see but you"
#     (C*) D* [Am] D*  D*  D*  A*                 "when you dance, dance, dance"
#     [F] (D*) C* D*  (D*) C* D*  (D*) C* D*     "a feeling good, good, creeping up on you"
#     (C*) D* [Am] D*  D*  D*                     "so just dance, dance, dance, come on"
#     E** D** (C**) D***                          "I can't stop the feeling"
# Simplified to a monophonic line in C major (upper octave).
name: Cant Stop the Feeling
tempo: 4
slots_per_beat: 2
melody:
    # Nothing I can see but you
    C5/0.5 D5/0.5 C5/0.5 D5/0.5 C5/0.5 D5/1
    # when you dance, dance, dance
    D5/0.5 D5/0.5 D5/1
    # A feeling good, good, creeping up on you
    C5/0.5 D5/0.5 C5/0.5 D5/0.5 C5/0.5 D5/1
    # so just dance, dance, dance, come on
    D5/0.5 D5/0.5 D5/1
    # I can't stop the feeling
    E5/0.5 D5/0.5 C5/1 D5/1
    # so just dance, dance, dance
    D5/0.5 D5/0.5 D5/1
